rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can only read/write their own profile, searches,
    // conversations, and price alerts. Everything else (priceHistory,
    // travelKnowledge) is written only by Cloud Functions (admin SDK
    // bypasses these rules) and is read-only for clients.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /searches/{searchId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /conversations/{conversationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /travelPreferences/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /priceAlerts/{alertId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /priceHistory/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // written only by Cloud Functions
    }

    match /travelKnowledge/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // written only by Cloud Functions / admin tooling
    }
  }
}
